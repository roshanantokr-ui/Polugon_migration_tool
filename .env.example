# =============================================================================
# Polygon Migration Tool - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------

# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-a-new-one

# Set to True for development, False for production
DEBUG=True

# Comma-separated list of allowed hosts
# For local development: localhost,127.0.0.1
# For production: your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
#
# Local setup with Docker:
#   docker run --name polygon-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=polygon_migration -p 5432:5432 -d postgres:15
#
# Then use these settings:
DB_NAME=polygon_migration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
#
# Local setup with Docker:
#   docker run --name polygon-redis -p 6379:6379 -d redis:7
#
# Then use these settings:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False

# For Azure Redis or other cloud Redis with SSL:
# REDIS_HOST=your-redis.redis.cache.windows.net
# REDIS_PORT=6380
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL=True

# -----------------------------------------------------------------------------
# Polygon API Credentials
# -----------------------------------------------------------------------------
#
# Get your API credentials from Polygon:
# 1. Log in to https://polygon.codeforces.com/
# 2. Go to Settings (top-right menu)
# 3. Find "API" section
# 4. Generate new API key
#
POLYGON_API_KEY=your-polygon-api-key
POLYGON_API_SECRET=your-polygon-api-secret

# -----------------------------------------------------------------------------
# Cloud Storage Configuration
# -----------------------------------------------------------------------------
#
# Test-case files are uploaded through the provider-neutral interface in
# problems/storage/. Layout: test_cases/{problem_id}/{test_number} (input)
# and test_cases/{problem_id}/{test_number}.a (output).
#
# Which storage provider to use. Supported: gdrive
STORAGE_PROVIDER=gdrive

# --- Google Drive (OAuth 2.0 web-server flow) ---
#
# 1. Google Cloud Console -> APIs & Services -> Library: enable "Google Drive API".
# 2. OAuth consent screen: add your Google account under "Test users"
#    (while the app is in Testing mode, authorization expires after 7 days).
# 3. Credentials -> Create OAuth client ID -> "Web application", with the
#    authorised redirect URI below. Download the JSON.
# 4. Keep the JSON OUTSIDE this repository and point to it here.
# 5. Start the server, open http://127.0.0.1:8000/google-drive/ (use 127.0.0.1,
#    not localhost) and click "Connect Google Drive".
#
# Scope used: https://www.googleapis.com/auth/drive.file - the app can only
# see and change the folders/files it creates; the rest of the Drive is untouched.
#
# Plain-http redirect URIs are only allowed when DEBUG=True and the URI is
# 127.0.0.1/localhost (OAUTHLIB_INSECURE_TRANSPORT is set in settings.py).
# Use an https redirect URI in any non-local deployment.
#
# Absolute path to the downloaded OAuth client JSON (contains the client secret).
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=C:\path\outside\repo\client_secret.json
# Where the app stores the OAuth token after you connect (created automatically).
GOOGLE_DRIVE_TOKEN_FILE=C:\path\outside\repo\google_drive_token.json
# Must exactly match an authorised redirect URI of the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/google-drive/callback/

# -----------------------------------------------------------------------------
# Custom Checker Compilation
# -----------------------------------------------------------------------------
#
# Directory for compiling custom checkers (optional)
# If not set, uses system temp directory
# Requires g++ compiler installed on your system
#
# CUSTOM_CHECKER_DIR=/path/to/checker/directory

# -----------------------------------------------------------------------------
# Quick Start Commands
# -----------------------------------------------------------------------------
#
# 1. Start PostgreSQL and Redis:
#    docker run --name polygon-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=polygon_migration -p 5432:5432 -d postgres:15
#    docker run --name polygon-redis -p 6379:6379 -d redis:7
#
# 2. Apply migrations:
#    python manage.py migrate
#
# 3. Create superuser:
#    python manage.py createsuperuser
#
# 4. Run server:
#    python manage.py runserver
#
# 5. Access app:
#    http://127.0.0.1:8000/
#
